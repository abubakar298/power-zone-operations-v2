NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:55432/power_zone
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_TOKEN=
# Production requires HTTPS APP_ORIGIN. Do not disable certificate verification.
DATABASE_SSL=false
DATABASE_CA_FILE=
# Set to 1 only behind a single trusted reverse proxy; otherwise 0.
TRUST_PROXY_HOPS=0

# Optional: leave absent until email sending is activated and sender domain verified.
# EMAIL_FROM=e-desk@powerzone.systems
# EMAIL_FROM_NAME=Rafiq · Power Zone Systems
# RESEND_API_KEY=
# EMAIL_TOKEN_ENCRYPTION_KEY=
